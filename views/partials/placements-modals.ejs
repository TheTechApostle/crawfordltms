<%# "Level & semester per programme" modals. A course has its own level and
    semester (its home programme's); every OTHER programme that offers it can
    take it at a different level and/or semester — e.g. CYB201 at 300L for
    Computer Science but 200L for Cyber Security. Blank = same as the course.
    Needs: courses, linked, actionBase, canManage(course), optional extraQuery/programme. %>
<% courses.forEach(function(c){ if (!canManage(c)) return;
   const others = (linked[c.id] || []).filter(function(l){ return l.programme_id !== c.programme_id; }); %>
  <div class="modal fade" id="placeModal<%= c.id %>" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
      <form class="modal-content" method="POST" action="<%= actionBase %>/<%= c.id %>/placements">
        <% if (typeof programme !== 'undefined' && programme) { %><input type="hidden" name="programme_id" value="<%= programme.id %>"><% } %>
        <div class="modal-header">
          <h5 class="modal-title h6"><i class="fa-solid fa-layer-group me-1"></i> Level &amp; semester per programme — <%= c.code %></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p class="text-secondary small">The course itself is set at <strong><%= c.level %> level</strong>, semester <strong><%= c.semester %></strong>. Any other programme can take it at a different level and/or semester — leave a box blank to use the course's own.</p>
          <% if (!others.length) { %>
            <p class="text-secondary mb-0">No other programmes offer this course yet — add some under <em>Offered by</em> first.</p>
          <% } else { %>
          <div class="table-responsive"><table class="table table-sm align-middle mb-0">
            <thead><tr><th>Programme</th><th>Mode</th><th style="width:120px;">Level</th><th style="min-width:200px;">Semester</th></tr></thead>
            <tbody>
            <% others.forEach(function(l){ %>
              <tr>
                <td><%= l.name %> <span class="text-secondary small">(<%= l.dept_code || l.dept_name %>)</span></td>
                <td><span class="badge bg-light text-dark border fw-normal"><%= modeShort(l.study_mode) %></span></td>
                <td><input class="form-control form-control-sm" type="number" name="level_<%= l.programme_id %>" value="<%= l.placement_level || '' %>" placeholder="<%= c.level %>"></td>
                <td>
                  <select class="form-select form-select-sm" name="semester_<%= l.programme_id %>">
                    <option value="">Same as course (<%= semLabel(l.study_mode, c.semester) %>)</option>
                    <% semOptions(l.study_mode).forEach(function(o){ %><option value="<%= o.number %>" <%= l.placement_semester === o.number ? 'selected' : '' %>><%= o.name %></option><% }) %>
                  </select>
                </td>
              </tr>
            <% }) %>
            </tbody>
          </table></div>
          <% } %>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-gold" <%= others.length ? '' : 'disabled' %>><i class="fa-solid fa-check me-1"></i> Save</button>
        </div>
      </form>
    </div>
  </div>
<% }) %>
