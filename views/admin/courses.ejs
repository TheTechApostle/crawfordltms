<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4 pb-3 border-bottom">
  <div><div class="kicker">Academic structure</div><h1 class="h3 mb-0">Courses</h1></div>
  <div class="d-flex gap-2 align-items-center">
    <% if (session) { %><span class="badge bg-light text-dark border"><%= session.name %></span><% } %>
    <a class="btn btn-gold" href="/admin/courses/import"><i class="fa-solid fa-file-arrow-up me-1"></i> Bulk upload</a>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-8">
    <div class="card h-100"><div class="card-body">
      <h2 class="h6 card-title"><i class="fa-solid fa-book me-1 text-secondary"></i> Course catalogue</h2>
      <p class="text-secondary small">Courses proposed by an HOD normally go through Dean approval — but as registrar you can edit, approve or reject any course directly. Courses you add here go straight to approved.</p>

      <% const returnTo = '/admin/courses' + (deptFilter ? '?department_id=' + deptFilter : ''); %>
      <form method="GET" action="/admin/courses" class="d-flex flex-wrap align-items-end gap-2 mb-3">
        <div>
          <label class="form-label mb-1" for="df">Department</label>
          <select id="df" name="department_id" class="form-select form-select-sm" onchange="this.form.submit()" style="min-width:240px;">
            <option value="">All departments</option>
            <% departments.forEach(function(d){ %><option value="<%= d.id %>" <%= String(deptFilter) === String(d.id) ? 'selected' : '' %>><%= d.name %></option><% }) %>
          </select>
        </div>
        <span class="text-secondary small pb-1"><%= courses.length %> course<%= courses.length === 1 ? '' : 's' %></span>
        <div class="ms-auto">
          <button form="bulk-delete-courses" type="submit" class="btn btn-sm btn-danger" id="bulkDeleteBtn" disabled data-confirm="Delete the ticked courses? Their offerings and draft timetable slots go too. Courses with student registrations or a published timetable are kept."><i class="fa-solid fa-trash me-1"></i> Delete ticked (<span id="bulkCount">0</span>)</button>
        </div>
      </form>
      <form id="bulk-delete-courses" method="POST" action="/admin/courses/bulk-delete"><input type="hidden" name="return_to" value="<%= returnTo %>"></form>

      <% courses.forEach(function(c){ %>
        <form id="edit-course-<%= c.id %>" method="POST" action="/admin/courses/<%= c.id %>/edit"></form>
        <form id="delete-course-<%= c.id %>" method="POST" action="/admin/courses/<%= c.id %>/delete"><input type="hidden" name="return_to" value="<%= returnTo %>"></form>
        <% if (c.status !== 'approved') { %>
          <form id="approve-course-<%= c.id %>" method="POST" action="/admin/courses/<%= c.id %>/approve"></form>
        <% } %>
        <% if (c.status !== 'rejected') { %>
          <form id="reject-course-<%= c.id %>" method="POST" action="/admin/courses/<%= c.id %>/reject">
            <input type="hidden" name="reason" value="Not approved by the registrar">
          </form>
        <% } %>
        <% if (session && c.status === 'approved') { %>
          <form id="offer-course-<%= c.id %>" method="POST" action="/admin/courses/<%= c.id %>/offer"></form>
        <% } %>
      <% }) %>

      <div class="table-responsive"><table class="table table-hover align-middle mb-0">
        <thead><tr><th><input type="checkbox" class="form-check-input" id="selAll" title="Tick all shown"></th><th style="min-width:100px;">Code</th><th style="min-width:180px;">Title</th><th>Dept</th><th>Home programme</th><th>Offered by</th><th>Level</th><th>Semester</th><th>Type</th><th>Units</th><th>Est. size</th><th>Status</th><th style="min-width:260px;"></th></tr></thead>
        <tbody>
        <% courses.forEach(function(c){ %>
          <tr>
            <td><input type="checkbox" class="form-check-input sel-course" form="bulk-delete-courses" name="course_ids" value="<%= c.id %>"></td>
            <td><input form="edit-course-<%= c.id %>" class="form-control form-control-sm font-monospace" name="code" value="<%= c.code %>" required></td>
            <td><input form="edit-course-<%= c.id %>" class="form-control form-control-sm" name="title" value="<%= c.title %>" required></td>
            <td>
              <select form="edit-course-<%= c.id %>" class="form-select form-select-sm" name="department_id" required>
                <% departments.forEach(function(d){ %>
                  <option value="<%= d.id %>" <%= c.department_id === d.id ? 'selected' : '' %>><%= d.name %></option>
                <% }) %>
              </select>
            </td>
            <td>
              <select form="edit-course-<%= c.id %>" class="form-select form-select-sm" name="programme_id">
                <option value="">— none —</option>
                <% programmes.forEach(function(p){ %>
                  <option value="<%= p.id %>" <%= c.programme_id === p.id ? 'selected' : '' %>><%= p.name %></option>
                <% }) %>
              </select>
            </td>
            <td>
              <%- include('../partials/programme-badges', { list: linked[c.id], homeId: c.programme_id, info: scopes[c.id] }) %>
              <button type="button" class="btn btn-sm btn-link p-0 ms-1" data-bs-toggle="modal" data-bs-target="#shareModal<%= c.id %>" title="Choose the programmes (any college) that offer this course"><i class="fa-solid fa-pen-to-square"></i></button>
              <button type="button" class="btn btn-sm btn-link p-0 ms-1" data-bs-toggle="modal" data-bs-target="#placeModal<%= c.id %>" title="Level and semester each programme takes it at"><i class="fa-solid fa-layer-group"></i></button>
            </td>
            <td><input form="edit-course-<%= c.id %>" class="form-control form-control-sm" name="level" type="number" style="width:75px;" value="<%= c.level %>" required></td>
            <td><%- include('../partials/semester-select', { value: c.semester, form: 'edit-course-' + c.id, cls: 'form-select-sm' }) %></td>
            <td>
              <select form="edit-course-<%= c.id %>" class="form-select form-select-sm" name="course_type" style="min-width:110px;">
                <option value="compulsory" <%= c.course_type !== 'elective' ? 'selected' : '' %>>Compulsory</option>
                <option value="elective" <%= c.course_type === 'elective' ? 'selected' : '' %>>Elective</option>
              </select>
            </td>
            <td><input form="edit-course-<%= c.id %>" class="form-control form-control-sm" name="credit_units" type="number" style="width:65px;" value="<%= c.credit_units %>"></td>
            <td><input form="edit-course-<%= c.id %>" class="form-control form-control-sm" name="expected_class_size" type="number" style="width:80px;" value="<%= c.expected_class_size || '' %>" placeholder="—"></td>
            <td><span class="badge badge-<%= c.status === 'approved' ? 'published' : (c.status === 'rejected' ? 'rejected' : 'draft') %>"><%= c.status %></span></td>
            <td class="d-flex gap-2 flex-wrap">
              <button form="edit-course-<%= c.id %>" class="btn btn-sm btn-outline-secondary" type="submit"><i class="fa-solid fa-check me-1"></i> Save</button>
              <% if (c.status !== 'approved') { %>
                <button form="approve-course-<%= c.id %>" class="btn btn-sm btn-gold" type="submit"><i class="fa-solid fa-thumbs-up me-1"></i> Approve</button>
              <% } %>
              <% if (c.status !== 'rejected') { %>
                <button form="reject-course-<%= c.id %>" class="btn btn-sm btn-outline-danger" type="submit"><i class="fa-solid fa-thumbs-down me-1"></i> Reject</button>
              <% } %>
              <% if (session && c.status === 'approved') { %>
                <button form="offer-course-<%= c.id %>" class="btn btn-sm btn-outline-secondary" type="submit"><i class="fa-solid fa-share me-1"></i> Offer this session</button>
              <% } %>
              <button form="delete-course-<%= c.id %>" class="btn btn-sm btn-danger" type="submit" data-confirm="Delete <%= c.code %><%= c.offering_count > 0 ? ' and its session offerings' : '' %>?"><i class="fa-solid fa-trash me-1"></i> Delete</button>
            </td>
          </tr>
        <% }) %>
        </tbody>
      </table></div>
    </div></div>
  </div>

  <div class="col-lg-4">
    <div class="card h-100"><div class="card-body">
      <h2 class="h6 card-title"><i class="fa-solid fa-plus me-1 text-secondary"></i> Add course</h2>
      <form method="POST" action="/admin/courses">
        <div class="row g-2">
          <div class="col-6 mb-3"><label for="code" class="form-label">Course code</label><input class="form-control" id="code" name="code" required placeholder="CSC313"></div>
          <div class="col-6 mb-3"><label for="level" class="form-label">Level</label><input class="form-control" id="level" name="level" type="number" required placeholder="300"></div>
        </div>
        <div class="mb-3">
          <label for="title" class="form-label">Title</label>
          <input class="form-control" id="title" name="title" required placeholder="Operations Research">
        </div>
        <div class="row g-2">
          <div class="col-6 mb-3"><label for="credit_units" class="form-label">Credit units</label><input class="form-control" id="credit_units" name="credit_units" type="number" value="3"></div>
          <div class="col-6 mb-3"><label for="course_type" class="form-label">Course type</label>
            <select class="form-select" id="course_type" name="course_type"><option value="compulsory">Compulsory</option><option value="elective">Elective</option></select></div>
        </div>
        <div class="mb-3">
          <label class="form-label">Semester <span class="text-secondary small">(the course's own; other programmes can differ)</span></label>
          <%- include('../partials/semester-select', { value: 1, cls: '' }) %>
        </div>
        <div class="row g-2">
          <div class="col-12 mb-3">
            <label for="department_id" class="form-label">Department</label>
            <select class="form-select" id="department_id" name="department_id" required>
              <% departments.forEach(function(d){ %><option value="<%= d.id %>"><%= d.name %></option><% }) %>
            </select>
          </div>
        </div>
        <div class="row g-2">
          <div class="col-6 mb-3">
            <label for="programme_id" class="form-label">Home programme</label>
            <select class="form-select" id="programme_id" name="programme_id">
              <option value="">— none —</option>
              <% programmes.forEach(function(p){ %><option value="<%= p.id %>"><%= p.name %></option><% }) %>
            </select>
          </div>
          <div class="col-6 mb-3">
            <label for="expected_class_size" class="form-label">Est. class size</label>
            <input class="form-control" id="expected_class_size" name="expected_class_size" type="number" placeholder="optional">
            <div class="form-text">Lets the assigned lecturer fix their own lecture's time/venue before students register.</div>
          </div>
        </div>
        <%- include('../partials/scope-fields', { allProgrammes: allProgrammes }) %>
        <button class="btn btn-gold" type="submit"><i class="fa-solid fa-plus me-1"></i> Add course</button>
      </form>
    </div></div>
  </div>
</div>

<% if (session) { %>
<div class="card mt-3"><div class="card-body">
  <h2 class="h6 card-title"><i class="fa-solid fa-list-check me-1 text-secondary"></i> Offerings this session</h2>
  <% if (!offerings.length) { %>
    <p class="text-secondary mb-0">No courses offered yet — click "Offer this session" above.</p>
  <% } else { %>
    <div class="table-responsive"><table class="table table-hover align-middle mb-0">
      <thead><tr><th>Course</th><th>Mode</th><th>Semester</th><th>Lecturer</th><th>Allocation</th><th>Registered</th></tr></thead>
      <tbody>
      <% offerings.forEach(function(o){ %>
        <tr><td><%= o.code %> — <%= o.title %></td><td><%= modeLabel(o.study_mode) %></td><td><%= semLabel(o.study_mode, o.semester) %></td><td><%= o.lecturer_name || 'Unassigned' %></td>
          <td><span class="badge badge-<%= ({approved:'published',pending:'lecturer_ok',rejected:'rejected',none:'draft'})[o.allocation_status] %>"><%= ({approved:'approved',pending:'awaiting HOD' + (o.proposed_name ? ' (' + o.proposed_name + ')' : ''),rejected:'sent back',none:'not allocated'})[o.allocation_status] %></span></td>
          <td><%= o.registered_count %></td></tr>
      <% }) %>
      </tbody>
    </table></div>
  <% } %>
</div></div>
<% } %>

<%- include('../partials/share-modals', { courses: courses, linked: linked, allProgrammes: allProgrammes, scopes: scopes, actionBase: '/admin/courses', canManage: function(){ return true; } }) %>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var boxes = Array.prototype.slice.call(document.querySelectorAll('.sel-course'));
    var all = document.getElementById('selAll'), btn = document.getElementById('bulkDeleteBtn'), cnt = document.getElementById('bulkCount');
    function refresh() {
      var n = boxes.filter(function (b) { return b.checked; }).length;
      cnt.textContent = n; btn.disabled = n === 0;
      all.checked = n > 0 && n === boxes.length; all.indeterminate = n > 0 && n < boxes.length;
    }
    all.addEventListener('change', function () { boxes.forEach(function (b) { b.checked = all.checked; }); refresh(); });
    boxes.forEach(function (b) { b.addEventListener('change', refresh); });
    refresh();
  });
</script>
<%- include('../partials/placements-modals', { courses: courses, linked: linked, actionBase: '/admin/courses', canManage: function(){ return true; } }) %>
