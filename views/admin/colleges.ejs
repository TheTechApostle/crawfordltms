<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4 pb-3 border-bottom">
  <div><div class="kicker">Academic structure</div><h1 class="h3 mb-0">Colleges</h1></div>
</div>

<div class="row g-3">
  <div class="col-lg-8">
    <div class="card h-100"><div class="card-body">
      <h2 class="h6 card-title"><i class="fa-solid fa-landmark me-1 text-secondary"></i> All colleges</h2>
      <% if (!colleges.length) { %>
        <p class="text-secondary mb-0">No colleges yet — add one to start grouping departments under it.</p>
      <% } else { %>

        <% colleges.forEach(function(c){ %>
          <form id="edit-col-<%= c.id %>" method="POST" action="/admin/colleges/<%= c.id %>/edit"></form>
          <form id="delete-col-<%= c.id %>" method="POST" action="/admin/colleges/<%= c.id %>/delete"></form>
        <% }) %>

        <div class="table-responsive"><table class="table table-hover align-middle mb-0">
          <thead><tr><th>Code</th><th>Name</th><th>Dean</th><th>Departments</th><th style="min-width:150px;"></th></tr></thead>
          <tbody>
          <% colleges.forEach(function(c){ %>
            <tr>
              <td><input form="edit-col-<%= c.id %>" class="form-control form-control-sm font-monospace" style="width:90px;" name="code" value="<%= c.code %>" required></td>
              <td><input form="edit-col-<%= c.id %>" class="form-control form-control-sm" name="name" value="<%= c.name %>" required></td>
              <td>
                <select form="edit-col-<%= c.id %>" class="form-select form-select-sm" name="dean_id">
                  <option value="">— unassigned —</option>
                  <% deans.forEach(function(d){ %>
                    <option value="<%= d.id %>" <%= c.dean_id === d.id ? 'selected' : '' %>><%= d.name %></option>
                  <% }) %>
                </select>
              </td>
              <td><span class="badge bg-light text-dark border"><%= c.dept_count %></span></td>
              <td class="d-flex gap-2">
                <button form="edit-col-<%= c.id %>" class="btn btn-sm btn-outline-secondary" type="submit"><i class="fa-solid fa-check me-1"></i> Save</button>
                <button form="delete-col-<%= c.id %>" class="btn btn-sm btn-danger" type="submit" <%= c.dept_count > 0 ? 'disabled title="Move or delete its departments first"' : '' %> data-confirm="Delete this college?"><i class="fa-solid fa-trash me-1"></i> Delete</button>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table></div>
        <p class="form-text mt-2 mb-0">Reassigning the Dean here actually hands them the college's approval queue — not just a label change.</p>
      <% } %>
    </div></div>
  </div>

  <div class="col-lg-4">
    <div class="card h-100"><div class="card-body">
      <h2 class="h6 card-title"><i class="fa-solid fa-plus me-1 text-secondary"></i> Add college</h2>
      <form method="POST" action="/admin/colleges">
        <div class="mb-3">
          <label for="name" class="form-label">College name</label>
          <input class="form-control" id="name" name="name" required placeholder="College of Natural and Applied Sciences">
        </div>
        <div class="mb-3">
          <label for="code" class="form-label">Code</label>
          <input class="form-control" id="code" name="code" required placeholder="CNAS">
        </div>
        <div class="mb-3">
          <label for="dean_id" class="form-label">Dean</label>
          <select class="form-select" id="dean_id" name="dean_id">
            <option value="">— unassigned —</option>
            <% deans.forEach(function(d){ %><option value="<%= d.id %>"><%= d.name %></option><% }) %>
          </select>
          <div class="form-text">Only accounts with the Dean role show up here.</div>
        </div>
        <button class="btn btn-gold" type="submit"><i class="fa-solid fa-plus me-1"></i> Add college</button>
      </form>
    </div></div>
  </div>
</div>
