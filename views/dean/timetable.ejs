<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4 pb-3 border-bottom">
  <div><div class="kicker">Dean / Timetable Committee<% if (college) { %> · <%= college.name %><% } %></div><h1 class="h3 mb-0">College timetable</h1></div>
  <% if (session) { %><span class="badge bg-light text-dark border"><%= session.name %></span><% } %>
</div>

<div class="card"><div class="card-body">
  <% if (!college) { %>
    <div class="text-center py-5 text-secondary">
      <i class="fa-solid fa-landmark fa-2x mb-2 d-block text-secondary"></i>
      <h3 class="h5 text-dark">No college assigned</h3>
      <p class="mb-0">Ask the registrar to set you as Dean of a college.</p>
    </div>
  <% } else { %>
    <form method="GET" action="/dean/timetable" class="row g-2 align-items-end mb-3">
      <div class="col-md-4">
        <label class="form-label" for="department_id">Department</label>
        <select class="form-select" id="department_id" name="department_id" onchange="this.form.programme_id.value=''; this.form.submit()">
          <option value="">All departments</option>
          <% departments.forEach(function(d){ %><option value="<%= d.id %>" <%= String(deptId) === String(d.id) ? 'selected' : '' %>><%= d.name %></option><% }) %>
        </select>
      </div>
      <div class="col-md-4">
        <label class="form-label" for="programme_id">Programme</label>
        <select class="form-select" id="programme_id" name="programme_id" onchange="this.form.submit()">
          <option value="">All programmes</option>
          <% programmes.forEach(function(p){ %><option value="<%= p.id %>" <%= String(progId) === String(p.id) ? 'selected' : '' %>><%= p.name %></option><% }) %>
        </select>
      </div>
      <div class="col-md-4"><% if (deptId || progId) { %><a class="btn btn-outline-secondary" href="/dean/timetable">Clear filter</a><% } %></div>
    </form>
    <h2 class="h6 card-title"><i class="fa-solid fa-table-cells me-1 text-secondary"></i> Scheduled classes — <%= progId ? 'selected programme' : (deptId ? 'selected department' : college.name) %></h2>
    <p class="text-secondary small">Click a course code for the full picture — department, lecturer, venue, registered count, and current approval status.</p>
    <%- include('../partials/timetable-grid', { entries, bands }) %>
  <% } %>
</div></div>

<%- include('../partials/course-detail-modal') %>
