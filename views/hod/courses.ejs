<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4 pb-3 border-bottom">
  <div><div class="kicker">Head of Department<% if (dept && dept.college_name) { %> · <%= dept.college_name %><% } %></div><h1 class="h3 mb-0">Courses</h1></div>
  <% if (session) { %><span class="badge bg-light text-dark border"><%= session.name %></span><% } %>
</div>

<% if (!dept) { %>
  <div class="text-center py-5 text-secondary"><h3 class="h5 text-dark">No department assigned</h3><p>Ask the registrar to link your account to a department.</p></div>
<% } else { %>
<% const free = programmes.filter(function(p){ return !p.coordinator_name; }); %>

<div class="row g-3 mb-3">
  <div class="col-lg-8"><div class="card h-100"><div class="card-body">
    <h2 class="h6 card-title"><i class="fa-solid fa-plus me-1 text-secondary"></i> Propose a new course</h2>
    <p class="text-secondary small">Goes to the Dean of <%= dept.college_name || 'your college' %> for approval before it can be offered. You add courses directly for programmes without a Programme Coordinator (or no programme); coordinators add their own programme's courses.</p>
    <form method="POST" action="/hod/courses">
      <div class="row g-2">
        <div class="col-md-3 mb-3"><label class="form-label">Code</label><input class="form-control" name="code" required placeholder="CSC420"></div>
        <div class="col-md-5 mb-3"><label class="form-label">Title</label><input class="form-control" name="title" required placeholder="Machine Learning"></div>
        <div class="col-md-2 mb-3"><label class="form-label">Level</label><input class="form-control" name="level" type="number" required placeholder="400"></div>
        <div class="col-md-2 mb-3"><label class="form-label">Units</label><input class="form-control" name="credit_units" type="number" value="3"></div>
      </div>
      <div class="row g-2">
        <div class="col-md-4 mb-3">
          <label class="form-label">Home programme</label>
          <select class="form-select" name="programme_id">
            <option value="">— none —</option>
            <% free.forEach(function(p){ %><option value="<%= p.id %>"><%= p.name %></option><% }) %>
          </select>
          <% if (programmes.length > free.length) { %><div class="form-text">Programmes with a coordinator aren't listed.</div><% } %>
        </div>
        <div class="col-md-3 mb-3">
          <label class="form-label">Est. class size</label>
          <input class="form-control" name="expected_class_size" type="number" placeholder="optional">
        </div>
      </div>
      <%- include('../partials/scope-fields', { allProgrammes: allProgrammes }) %>
      <button class="btn btn-gold" type="submit"><i class="fa-solid fa-paper-plane me-1"></i> Submit for approval</button>
    </form>
  </div></div></div>

  <div class="col-lg-4"><div class="card h-100"><div class="card-body">
    <h2 class="h6 card-title"><i class="fa-solid fa-link me-1 text-secondary"></i> Add an existing course</h2>
    <p class="text-secondary small">Another department or college already runs it? Add it to one of your programmes instead of duplicating it.</p>
    <form method="POST" action="/hod/courses/link">
      <div class="mb-3"><label class="form-label">Course code</label><input class="form-control" name="code" required placeholder="GST201"></div>
      <div class="mb-3"><label class="form-label">Programme</label>
        <select class="form-select" name="programme_id" required>
          <% free.forEach(function(p){ %><option value="<%= p.id %>"><%= p.name %></option><% }) %>
        </select>
      </div>
      <button class="btn btn-outline-secondary" type="submit" <%= free.length ? '' : 'disabled' %>><i class="fa-solid fa-link me-1"></i> Add to programme</button>
    </form>
  </div></div></div>
</div>

<div class="card"><div class="card-body">
  <h2 class="h6 card-title"><i class="fa-solid fa-book me-1 text-secondary"></i> Department courses</h2>
  <% if (!courses.length) { %>
    <p class="text-secondary mb-0">No courses in this department yet — propose one above.</p>
  <% } else { %>

    <%# Standalone forms, one per editable/deletable course, referenced from
        table cells via the HTML form="" attribute — this avoids the invalid
        (and unsupported) pattern of a <form> element wrapping <td>s. %>
    <% courses.forEach(function(c){ %>
      <% if (['pending','rejected'].includes(c.status) && c.managed_by === 'hod') { %>
        <form id="edit-<%= c.id %>" method="POST" action="/hod/courses/<%= c.id %>/edit"></form>
        <form id="delete-<%= c.id %>" method="POST" action="/hod/courses/<%= c.id %>/delete"></form>
      <% } else if (session && c.status === 'approved' && !c.offered_this_session) { %>
        <form id="offer-<%= c.id %>" method="POST" action="/hod/courses/<%= c.id %>/offer"></form>
      <% } %>
    <% }) %>

    <div class="table-responsive"><table class="table table-hover align-middle mb-0">
      <thead><tr><th style="min-width:110px;">Code</th><th style="min-width:200px;">Title</th><th>Home programme</th><th>Offered by</th><th>Level</th><th>Units</th><th>Est. size</th><th>Status</th><th style="min-width:230px;"></th></tr></thead>
      <tbody>
      <% courses.forEach(function(c){ %>
        <% const editable = ['pending','rejected'].includes(c.status) && c.managed_by === 'hod'; %>
        <tr>
          <% if (editable) { %>
            <td><input form="edit-<%= c.id %>" class="form-control form-control-sm" name="code" value="<%= c.code %>" required></td>
            <td><input form="edit-<%= c.id %>" class="form-control form-control-sm" name="title" value="<%= c.title %>" required></td>
            <td>
              <select form="edit-<%= c.id %>" class="form-select form-select-sm" name="programme_id">
                <option value="">— none —</option>
                <% free.forEach(function(p){ %><option value="<%= p.id %>" <%= c.programme_id === p.id ? 'selected' : '' %>><%= p.name %></option><% }) %>
              </select>
            </td>
            <td><%- include('../partials/programme-badges', { list: linked[c.id], homeId: c.programme_id, info: scopes[c.id] }) %></td>
            <td><input form="edit-<%= c.id %>" class="form-control form-control-sm" name="level" type="number" value="<%= c.level %>" style="width:80px;" required></td>
            <td><input form="edit-<%= c.id %>" class="form-control form-control-sm" name="credit_units" type="number" value="<%= c.credit_units %>" style="width:70px;"></td>
            <td><input form="edit-<%= c.id %>" class="form-control form-control-sm" name="expected_class_size" type="number" value="<%= c.expected_class_size || '' %>" style="width:80px;" placeholder="—"></td>
            <td>
              <span class="badge badge-<%= c.status === 'rejected' ? 'rejected' : 'draft' %>"><%= c.status %></span>
              <% if (c.status === 'rejected' && c.reject_reason) { %>
                <div class="form-text mb-0"><%= c.reject_reason %></div>
              <% } %>
            </td>
            <td class="d-flex gap-2 flex-wrap">
              <button form="edit-<%= c.id %>" class="btn btn-sm btn-gold" type="submit"><i class="fa-solid fa-check me-1"></i> Save<%= c.status === 'rejected' ? ' & resubmit' : '' %></button>
              <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#shareModal<%= c.id %>"><i class="fa-solid fa-share-nodes"></i></button>
              <button form="delete-<%= c.id %>" class="btn btn-sm btn-danger" type="submit" data-confirm="Delete this course proposal?"><i class="fa-solid fa-trash"></i></button>
            </td>
          <% } else { %>
            <td class="font-monospace"><%= c.code %></td>
            <td><%= c.title %></td>
            <td class="text-secondary small"><%= c.programme_name || '—' %><% if (c.coordinator_name) { %><div class="form-text mb-0"><i class="fa-solid fa-user-tie me-1"></i>Coordinator: <%= c.coordinator_name %></div><% } %></td>
            <td><%- include('../partials/programme-badges', { list: linked[c.id], homeId: c.programme_id, info: scopes[c.id] }) %></td>
            <td><%= c.level %></td>
            <td><%= c.credit_units %></td>
            <td><%= c.expected_class_size || '—' %></td>
            <td>
              <span class="badge badge-<%= c.status === 'approved' ? 'published' : (c.status === 'rejected' ? 'rejected' : 'draft') %>"><%= c.status %></span>
              <% if (c.managed_by === 'coordinator' && c.status !== 'approved') { %><div class="form-text mb-0">run by coordinator</div><% } %>
            </td>
            <td class="d-flex gap-2 flex-wrap">
              <% if (c.managed_by === 'hod') { %>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#shareModal<%= c.id %>" title="Programmes that offer this course"><i class="fa-solid fa-share-nodes"></i></button>
              <% } %>
              <% if (c.status === 'approved' && session && !c.offered_this_session) { %>
                <button form="offer-<%= c.id %>" class="btn btn-sm btn-outline-secondary" type="submit"><i class="fa-solid fa-share me-1"></i> Offer this session</button>
              <% } else if (c.offered_this_session) { %>
                <a class="btn btn-sm btn-outline-secondary" href="/hod/assign"><i class="fa-solid fa-chalkboard-user me-1"></i> Lecturer</a>
              <% } %>
            </td>
          <% } %>
        </tr>
      <% }) %>
      </tbody>
    </table></div>
  <% } %>
</div></div>

<% if (sharedIn.length) { %>
<div class="card mt-3"><div class="card-body">
  <h2 class="h6 card-title"><i class="fa-solid fa-share-nodes me-1 text-secondary"></i> Shared in from other departments / colleges</h2>
  <p class="text-secondary small">Courses run by another department that one of your programmes also offers. The owning department proposes and allocates them.</p>
  <% sharedIn.filter(function(c){ return c.programme_id; }).forEach(function(c){ %><form id="unlink-<%= c.id %>-<%= c.programme_id %>" method="POST" action="/hod/courses/<%= c.id %>/unlink"><input type="hidden" name="programme_id" value="<%= c.programme_id %>"></form><% }) %>
  <div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead><tr><th>Code</th><th>Title</th><th>Level</th><th>Owned by</th><th>Your programme</th><th></th></tr></thead>
    <tbody>
    <% sharedIn.forEach(function(c){ %>
      <tr>
        <td class="font-monospace"><%= c.code %></td><td><%= c.title %></td><td><%= c.level %></td>
        <td><%= c.dept_name %><%= c.college_name ? ' · ' + c.college_name : '' %></td>
        <td><span class="badge bg-light text-dark border font-monospace"><%= c.programme_code %></span></td>
        <td><% if (c.programme_id) { %><button form="unlink-<%= c.id %>-<%= c.programme_id %>" class="btn btn-sm btn-outline-danger" type="submit" data-confirm="Stop offering <%= c.code %> under <%= c.programme_code %>?"><i class="fa-solid fa-link-slash me-1"></i> Remove</button><% } %></td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
</div></div>
<% } %>

<%- include('../partials/share-modals', { courses: courses, linked: linked, allProgrammes: allProgrammes, scopes: scopes, actionBase: '/hod/courses', canManage: function(c){ return c.managed_by === 'hod'; } }) %>
<% } %>
