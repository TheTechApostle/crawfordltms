<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4 pb-3 border-bottom">
  <div><div class="kicker"><%= dept ? dept.name : '' %></div><h1 class="h3 mb-0">Programmes</h1></div>
</div>

<% if (!dept) { %>
  <div class="text-center py-5 text-secondary">
    <h3 class="h5 text-dark">No department assigned</h3>
    <p>Contact the registrar to be assigned to a department.</p>
  </div>
<% } else { %>
<div class="row g-3">
  <div class="col-lg-8">
    <div class="card h-100"><div class="card-body">
      <h2 class="h6 card-title"><i class="fa-solid fa-diagram-project me-1 text-secondary"></i> Programmes under <%= dept.name %></h2>
      <p class="text-secondary small">Courses are uploaded against one of these programmes, not just the bare department — e.g. Computer Science / ICT / Cyber Security.</p>
      <% if (!programmes.length) { %>
        <p class="text-secondary mb-0">No programmes yet — add one to start uploading courses under it.</p>
      <% } else { %>

        <% programmes.forEach(function(p){ %>
          <form id="edit-prog-<%= p.id %>" method="POST" action="/hod/programmes/<%= p.id %>/edit"></form>
          <form id="delete-prog-<%= p.id %>" method="POST" action="/hod/programmes/<%= p.id %>/delete"></form>
        <% }) %>

        <div class="table-responsive"><table class="table table-hover align-middle mb-0">
          <thead><tr><th>Code</th><th>Name</th><th>Courses</th><th style="min-width:150px;"></th></tr></thead>
          <tbody>
          <% programmes.forEach(function(p){ %>
            <tr>
              <td><input form="edit-prog-<%= p.id %>" class="form-control form-control-sm font-monospace" style="width:90px;" name="code" value="<%= p.code %>" required></td>
              <td><input form="edit-prog-<%= p.id %>" class="form-control form-control-sm" name="name" value="<%= p.name %>" required></td>
              <td><span class="badge bg-light text-dark border"><%= p.course_count %></span></td>
              <td class="d-flex gap-2">
                <button form="edit-prog-<%= p.id %>" class="btn btn-sm btn-outline-secondary" type="submit"><i class="fa-solid fa-check me-1"></i> Save</button>
                <button form="delete-prog-<%= p.id %>" class="btn btn-sm btn-danger" type="submit" <%= p.course_count > 0 ? 'disabled title="Move or delete its courses first"' : '' %> data-confirm="Delete this programme?"><i class="fa-solid fa-trash me-1"></i> Delete</button>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table></div>
      <% } %>
    </div></div>
  </div>

  <div class="col-lg-4">
    <div class="card h-100"><div class="card-body">
      <h2 class="h6 card-title"><i class="fa-solid fa-plus me-1 text-secondary"></i> Add programme</h2>
      <form method="POST" action="/hod/programmes">
        <div class="mb-3">
          <label for="name" class="form-label">Programme name</label>
          <input class="form-control" id="name" name="name" required placeholder="Information and Communication Technology">
        </div>
        <div class="mb-3">
          <label for="code" class="form-label">Code</label>
          <input class="form-control" id="code" name="code" required placeholder="ICT">
        </div>
        <button class="btn btn-gold" type="submit"><i class="fa-solid fa-plus me-1"></i> Add programme</button>
      </form>
    </div></div>
  </div>
</div>
<% } %>
