<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4 pb-3 border-bottom">
  <div><div class="kicker">Programme Coordinator</div><h1 class="h3 mb-0">Dashboard</h1></div>
  <% if (session) { %><span class="badge bg-light text-dark border"><%= session.name %></span><% } %>
</div>

<% if (!programmes.length) { %>
  <div class="text-center py-5 text-secondary">
    <i class="fa-solid fa-diagram-project fa-2x mb-2 d-block text-secondary"></i>
    <h3 class="h5 text-dark">No programme assigned</h3>
    <p class="mb-0">Ask your Head of Department or the registrar to make you coordinator of a programme.</p>
  </div>
<% } else { %>
  <p class="text-secondary">You coordinate:
    <% programmes.forEach(function(p){ %><span class="badge bg-light text-dark border fw-normal"><%= p.name %> <span class="text-secondary">· <%= p.dept_name %></span></span> <% }) %>
  </p>
  <div class="row g-3 row-cols-1 row-cols-md-4">
    <div class="col"><div class="card stat-card h-100"><div class="card-body d-flex align-items-center gap-3">
      <span class="stat-icon"><i class="fa-solid fa-book"></i></span>
      <div><div class="stat-num"><%= stats.courses %></div><div class="text-secondary small">Courses you run</div></div>
    </div></div></div>
    <div class="col"><div class="card stat-card h-100"><div class="card-body d-flex align-items-center gap-3">
      <span class="stat-icon"><i class="fa-solid fa-hourglass-half"></i></span>
      <div><div class="stat-num"><%= stats.pendingCourses %></div><div class="text-secondary small">Awaiting Dean approval</div></div>
    </div></div></div>
    <div class="col"><div class="card stat-card h-100"><div class="card-body d-flex align-items-center gap-3">
      <span class="stat-icon"><i class="fa-solid fa-user-clock"></i></span>
      <div><div class="stat-num"><%= stats.awaitingHod %></div><div class="text-secondary small">Allocations awaiting HOD</div></div>
    </div></div></div>
    <div class="col"><div class="card stat-card h-100"><div class="card-body d-flex align-items-center gap-3">
      <span class="stat-icon"><i class="fa-solid fa-user-xmark"></i></span>
      <div><div class="stat-num"><%= stats.unallocated %></div><div class="text-secondary small">Offered, no lecturer yet<%= stats.rejected ? ' (' + stats.rejected + ' sent back)' : '' %></div></div>
    </div></div></div>
  </div>
  <div class="d-flex gap-2 flex-wrap mt-4">
    <a class="btn btn-gold" href="/coordinator/courses"><i class="fa-solid fa-book me-1"></i> Programme courses</a>
    <a class="btn btn-outline-secondary" href="/coordinator/allocation"><i class="fa-solid fa-chalkboard-user me-1"></i> Allocate lecturers</a>
  </div>
<% } %>
