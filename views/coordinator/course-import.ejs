<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4 pb-3 border-bottom">
  <div><div class="kicker">Programme Coordinator</div><h1 class="h3 mb-0">Bulk upload courses</h1></div>
  <a class="btn btn-outline-secondary" href="/coordinator/courses<%= programme ? '?programme_id=' + programme.id : '' %>"><i class="fa-solid fa-arrow-left me-1"></i> Back to programme courses</a>
</div>

<% if (!programme) { %>
  <div class="text-center py-5 text-secondary"><h3 class="h5 text-dark">No programme assigned</h3><p>Ask your Head of Department or the registrar to make you coordinator of a programme.</p></div>
<% } else { %>
<div class="row g-3">
  <div class="col-lg-7">
    <div class="card h-100"><div class="card-body">
      <h2 class="h6 card-title"><i class="fa-solid fa-file-arrow-up me-1 text-secondary"></i> Upload a CSV or paste rows</h2>
      <p class="text-secondary small">Courses are added to your programme and go to the Dean for approval, like any course you add by hand. Existing course codes are skipped.</p>
      <form method="POST" action="/coordinator/courses/import">
        <% if (programmes.length > 1) { %>
          <div class="mb-3">
            <label class="form-label" for="programme_id">Programme (used when a row has no programme_code)</label>
            <select class="form-select" id="programme_id" name="programme_id">
              <% programmes.forEach(function(p){ %><option value="<%= p.id %>" <%= p.id === programme.id ? 'selected' : '' %>><%= p.name %> (<%= p.dept_code %>)</option><% }) %>
            </select>
          </div>
        <% } else { %><input type="hidden" name="programme_id" value="<%= programme.id %>"><p class="small mb-3"><strong>Programme:</strong> <%= programme.name %></p><% } %>
        <div class="mb-3"><label class="form-label" for="csvfile">CSV file</label><input class="form-control" type="file" id="csvfile" accept=".csv,text/csv,text/plain"></div>
        <div class="mb-3">
          <textarea class="form-control font-monospace" id="csv" name="csv" rows="10" required
            placeholder="code,title,level,credit_units,programme_code,expected_class_size,course_type,semester,also_offered_by&#10;CSC350,Compiler Construction,300,3,,60,compulsory,1,&#10;CYB201,Intro to Cyber Security,200,3,,60,compulsory,1,CSC:CS@300/2"><%= csv %></textarea>
        </div>
        <button class="btn btn-gold" type="submit"><i class="fa-solid fa-file-import me-1"></i> Import courses</button>
        <a class="btn btn-outline-secondary" href="/coordinator/courses/template.csv"><i class="fa-solid fa-download me-1"></i> Download template</a>
      </form>
      <% if (result) { %>
        <hr>
        <p class="mb-2">
          <span class="badge badge-published"><%= result.created.length %> created</span>
          <% if (result.skipped.length) { %><span class="badge badge-draft"><%= result.skipped.length %> skipped</span><% } %>
          <% if (result.errors.length) { %><span class="badge badge-rejected"><%= result.errors.length %> with problems</span><% } %>
        </p>
        <% if (result.errors.length) { %><ul class="small text-secondary"><% result.errors.forEach(function(e){ %><li><%= e %></li><% }) %></ul><% } %>
        <% if (result.skipped.length) { %><p class="small text-secondary mb-0">Skipped: <%= result.skipped.join('; ') %></p><% } %>
      <% } %>
    </div></div>
  </div>
  <div class="col-lg-5">
    <div class="card h-100"><div class="card-body">
      <h2 class="h6 card-title"><i class="fa-solid fa-table-list me-1 text-secondary"></i> Columns</h2>
      <table class="table table-sm small"><tbody>
        <tr><td class="font-monospace">code, title, level</td><td><em>Required.</em> <code>level</code> is the level your programme takes it at.</td></tr>
        <tr><td class="font-monospace">credit_units</td><td>Defaults to 3.</td></tr>
        <tr><td class="font-monospace">programme_code</td><td>Optional: another programme you coordinate (write <code>DEPT:PROG</code> if the code is used in several departments).</td></tr>
        <tr><td class="font-monospace">expected_class_size</td><td>Optional.</td></tr>
        <tr><td class="font-monospace">course_type</td><td><code>compulsory</code> (default) or <code>elective</code>.</td></tr>
        <tr><td class="font-monospace">semester</td><td>1, 2 or 3 — your programme's semester (1 = Harmattan, 2 = Rain for full/part-time). Defaults to 1.</td></tr>
        <tr><td class="font-monospace">also_offered_by</td><td>Optional. Other programmes that take the same course, as <code>DEPT:PROG</code> separated by <code>|</code>. A programme may take it at a different level/semester: <code>CSC:CS@300/2</code> = Computer Science at 300L, semester 2 (e.g. you run CYB201 at 200L, Computer Science takes it at 300L). <code>ALL</code> = every programme; <code>CSC:*</code> = a whole department.</td></tr>
      </tbody></table>
    </div></div>
  </div>
</div>
<script>
  document.getElementById('csvfile').addEventListener('change', function (e) {
    var f = e.target.files[0]; if (!f) return;
    var r = new FileReader(); r.onload = function () { document.getElementById('csv').value = r.result; }; r.readAsText(f);
  });
</script>
<% } %>
