<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4 pb-3 border-bottom">
  <div><div class="kicker">Programme Coordinator<% if (programme) { %> · <%= programme.dept_name %><% } %></div><h1 class="h3 mb-0">Programme courses</h1></div>
  <% if (session) { %><span class="badge bg-light text-dark border"><%= session.name %></span><% } %>
</div>

<% if (!programme) { %>
  <div class="text-center py-5 text-secondary"><h3 class="h5 text-dark">No programme assigned</h3><p>Ask your Head of Department or the registrar to make you coordinator of a programme.</p></div>
<% } else { %>

<% if (programmes.length > 1) { %>
  <ul class="nav nav-tabs mb-3">
    <% programmes.forEach(function(p){ %>
      <li class="nav-item"><a class="nav-link <%= p.id === programme.id ? 'active' : '' %>" href="/coordinator/courses?programme_id=<%= p.id %>"><%= p.name %> <span class="text-secondary small">(<%= p.dept_code %>)</span></a></li>
    <% }) %>
  </ul>
<% } %>

<div class="row g-3 mb-3">
  <div class="col-lg-8"><div class="card h-100"><div class="card-body">
    <h2 class="h6 card-title"><i class="fa-solid fa-plus me-1 text-secondary"></i> Add a course to <%= programme.name %></h2>
    <p class="text-secondary small">Goes to the Dean of your college for approval before it can be offered.</p>
    <form method="POST" action="/coordinator/courses">
      <input type="hidden" name="programme_id" value="<%= programme.id %>">
      <div class="row g-2">
        <div class="col-md-3 mb-3"><label class="form-label">Code</label><input class="form-control" name="code" required placeholder="CSC420"></div>
        <div class="col-md-5 mb-3"><label class="form-label">Title</label><input class="form-control" name="title" required placeholder="Machine Learning"></div>
        <div class="col-md-2 mb-3"><label class="form-label">Level</label><input class="form-control" name="level" type="number" required placeholder="400"></div>
        <div class="col-md-2 mb-3"><label class="form-label">Units</label><input class="form-control" name="credit_units" type="number" value="3"></div>
      </div>
      <div class="row g-2"><div class="col-md-4 mb-3">
          <label class="form-label">Estimated class size</label>
          <input class="form-control" name="expected_class_size" type="number" placeholder="optional">
      </div></div>
      <%- include('../partials/scope-fields', { allProgrammes: allProgrammes }) %>
      <button class="btn btn-gold" type="submit"><i class="fa-solid fa-paper-plane me-1"></i> Submit for approval</button>
    </form>
  </div></div></div>

  <div class="col-lg-4"><div class="card h-100"><div class="card-body">
    <h2 class="h6 card-title"><i class="fa-solid fa-link me-1 text-secondary"></i> Add an existing course</h2>
    <p class="text-secondary small">Another programme or college already runs it (e.g. a service course)? Add it here so <%= programme.name %> offers it too — no duplicate course needed.</p>
    <form method="POST" action="/coordinator/courses/link">
      <input type="hidden" name="programme_id" value="<%= programme.id %>">
      <div class="mb-3"><label class="form-label">Course code</label><input class="form-control" name="code" required placeholder="GST201"></div>
      <button class="btn btn-outline-secondary" type="submit"><i class="fa-solid fa-link me-1"></i> Add to <%= programme.code %></button>
    </form>
  </div></div></div>
</div>

<div class="card"><div class="card-body">
  <h2 class="h6 card-title"><i class="fa-solid fa-book me-1 text-secondary"></i> Courses offered by <%= programme.name %></h2>
  <% if (!courses.length) { %>
    <p class="text-secondary mb-0">No courses yet — add one above.</p>
  <% } else { %>
    <% courses.forEach(function(c){ const mine = c.programme_id === programme.id; const editable = mine && ['pending','rejected'].includes(c.status); %>
      <% if (editable) { %>
        <form id="edit-<%= c.id %>" method="POST" action="/coordinator/courses/<%= c.id %>/edit"><input type="hidden" name="programme_id" value="<%= programme.id %>"></form>
        <form id="delete-<%= c.id %>" method="POST" action="/coordinator/courses/<%= c.id %>/delete"><input type="hidden" name="programme_id" value="<%= programme.id %>"></form>
      <% } else if (mine && session && c.status === 'approved' && !c.offered_this_session) { %>
        <form id="offer-<%= c.id %>" method="POST" action="/coordinator/courses/<%= c.id %>/offer"><input type="hidden" name="programme_id" value="<%= programme.id %>"></form>
      <% } else if (!mine) { %>
        <form id="unlink-<%= c.id %>" method="POST" action="/coordinator/courses/<%= c.id %>/unlink"><input type="hidden" name="programme_id" value="<%= programme.id %>"></form>
      <% } %>
    <% }) %>
    <div class="table-responsive"><table class="table table-hover align-middle mb-0">
      <thead><tr><th style="min-width:100px;">Code</th><th style="min-width:200px;">Title</th><th>Level</th><th>Units</th><th>Est. size</th><th>Also offered by</th><th>Status</th><th style="min-width:230px;"></th></tr></thead>
      <tbody>
      <% courses.forEach(function(c){ const mine = c.programme_id === programme.id; const editable = mine && ['pending','rejected'].includes(c.status); %>
        <tr>
          <% if (editable) { %>
            <td><input form="edit-<%= c.id %>" class="form-control form-control-sm font-monospace" name="code" value="<%= c.code %>" required></td>
            <td><input form="edit-<%= c.id %>" class="form-control form-control-sm" name="title" value="<%= c.title %>" required></td>
            <td><input form="edit-<%= c.id %>" class="form-control form-control-sm" name="level" type="number" value="<%= c.level %>" style="width:80px;" required></td>
            <td><input form="edit-<%= c.id %>" class="form-control form-control-sm" name="credit_units" type="number" value="<%= c.credit_units %>" style="width:70px;"></td>
            <td><input form="edit-<%= c.id %>" class="form-control form-control-sm" name="expected_class_size" type="number" value="<%= c.expected_class_size || '' %>" style="width:80px;" placeholder="—"></td>
          <% } else { %>
            <td class="font-monospace"><%= c.code %></td>
            <td><%= c.title %><% if (!mine) { %><div class="form-text mb-0"><i class="fa-solid fa-share-nodes me-1"></i>Owned by <%= c.dept_name %> — shared with this programme</div><% } %></td>
            <td><%= c.level %></td><td><%= c.credit_units %></td><td><%= c.expected_class_size || '—' %></td>
          <% } %>
          <td><%- include('../partials/programme-badges', { list: linked[c.id], homeId: c.programme_id, info: scopes[c.id] }) %></td>
          <td>
            <span class="badge badge-<%= c.status === 'approved' ? 'published' : (c.status === 'rejected' ? 'rejected' : 'draft') %>"><%= c.status %></span>
            <% if (c.status === 'rejected' && c.reject_reason) { %><div class="form-text mb-0"><%= c.reject_reason %></div><% } %>
          </td>
          <td class="d-flex gap-2 flex-wrap">
            <% if (editable) { %>
              <button form="edit-<%= c.id %>" class="btn btn-sm btn-gold" type="submit"><i class="fa-solid fa-check me-1"></i> Save<%= c.status === 'rejected' ? ' & resubmit' : '' %></button>
              <button form="delete-<%= c.id %>" class="btn btn-sm btn-danger" type="submit" data-confirm="Delete this course proposal?"><i class="fa-solid fa-trash"></i></button>
            <% } %>
            <% if (mine) { %>
              <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#shareModal<%= c.id %>"><i class="fa-solid fa-share-nodes me-1"></i> Offered by…</button>
              <% if (session && c.status === 'approved' && !c.offered_this_session) { %>
                <button form="offer-<%= c.id %>" class="btn btn-sm btn-outline-secondary" type="submit"><i class="fa-solid fa-share me-1"></i> Offer this session</button>
              <% } else if (c.offered_this_session) { %>
                <a class="btn btn-sm btn-outline-secondary" href="/coordinator/allocation?programme_id=<%= programme.id %>"><i class="fa-solid fa-chalkboard-user me-1"></i> Allocate</a>
              <% } %>
            <% } else { %>
              <button form="unlink-<%= c.id %>" class="btn btn-sm btn-outline-danger" type="submit" data-confirm="Stop offering <%= c.code %> under <%= programme.name %>?"><i class="fa-solid fa-link-slash me-1"></i> Remove</button>
            <% } %>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table></div>
  <% } %>
</div></div>

<%- include('../partials/share-modals', { courses: courses, linked: linked, allProgrammes: allProgrammes, scopes: scopes, actionBase: '/coordinator/courses', canManage: function(c){ return c.programme_id === programme.id; }, programme: programme }) %>
<% } %>
