<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4 pb-3 border-bottom">
  <div><div class="kicker">Lecturer · <%= offering.code %></div><h1 class="h3 mb-0">Roster</h1></div>
  <a class="btn btn-sm btn-outline-secondary" href="/lecturer/courses"><i class="fa-solid fa-arrow-left me-1"></i> Back to my courses</a>
</div>

<div class="card"><div class="card-body">
  <h2 class="h6 card-title"><i class="fa-solid fa-users me-1 text-secondary"></i> <%= offering.code %> — <%= offering.title %></h2>
  <p class="text-secondary"><%= roster.length %> student<%= roster.length === 1 ? '' : 's' %> registered.</p>
  <% if (!roster.length) { %>
    <p class="text-secondary mb-0">No students have registered for this course yet.</p>
  <% } else { %>
    <div class="table-responsive"><table class="table table-hover align-middle mb-0">
      <thead><tr><th>#</th><th>Name</th><th>Email</th><th>Level</th></tr></thead>
      <tbody>
      <% roster.forEach(function(s, i){ %>
        <tr><td><%= i + 1 %></td><td><%= s.name %></td><td class="font-monospace"><%= s.email %></td><td><%= s.level || '—' %></td></tr>
      <% }) %>
      </tbody>
    </table></div>
  <% } %>
</div></div>
