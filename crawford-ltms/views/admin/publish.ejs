<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4 pb-3 border-bottom">
  <div><div class="kicker">Timetable</div><h1 class="h3 mb-0">Publish queue</h1></div>
  <% if (session) { %><span class="badge bg-light text-dark border"><%= session.name %></span><% } %>
</div>

<div class="card"><div class="card-body">
  <h2 class="h6 card-title"><i class="fa-solid fa-paper-plane me-1 text-secondary"></i> Ready to publish</h2>
  <p class="text-secondary">These entries have cleared lecturer, HOD and dean sign-off. Publishing is the final registrar action — it makes the slot visible on student and lecturer read-only timetables.</p>
  <% if (!entries.length) { %>
    <p class="text-secondary mb-0">Nothing awaiting publication right now.</p>
  <% } else { %>
    <div class="table-responsive"><table class="table table-hover align-middle mb-0">
      <thead><tr><th>Course</th><th>Venue</th><th>Slot</th><th></th></tr></thead>
      <tbody>
      <% entries.forEach(function(e){ %>
        <tr>
          <td><%= e.code %> — <%= e.title %></td>
          <td><%= e.venue_name %></td>
          <td><%= e.day %> <%= e.start_time %>–<%= e.end_time %></td>
          <td>
            <form method="POST" action="/admin/publish/<%= e.id %>">
              <button class="btn btn-sm btn-gold" type="submit"><i class="fa-solid fa-upload me-1"></i> Publish</button>
            </form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table></div>
  <% } %>
</div></div>
