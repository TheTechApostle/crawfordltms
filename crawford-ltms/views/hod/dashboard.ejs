<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4 pb-3 border-bottom">
  <div><div class="kicker">Head of Department<% if (dept && dept.faculty_name) { %> · <%= dept.faculty_name %><% } %></div><h1 class="h3 mb-0"><%= dept ? dept.name : 'Dashboard' %></h1></div>
  <% if (session) { %><span class="badge bg-light text-dark border"><%= session.name %></span><% } %>
</div>

<% if (!dept) { %>
  <div class="text-center py-5 text-secondary">
    <i class="fa-solid fa-building-circle-exclamation fa-2x mb-2 d-block text-secondary"></i>
    <h3 class="h5 text-dark">No department assigned</h3><p>Ask the registrar to link your account to a department.</p>
  </div>
<% } else { %>
  <div class="row g-3 row-cols-1 row-cols-md-4">
    <div class="col"><div class="card stat-card h-100"><div class="card-body d-flex align-items-center gap-3">
      <span class="stat-icon"><i class="fa-solid fa-book"></i></span>
      <div><div class="stat-num"><%= courseCount %></div><div class="text-secondary small">Courses in department</div></div>
    </div></div></div>
    <div class="col"><div class="card stat-card h-100"><div class="card-body d-flex align-items-center gap-3">
      <span class="stat-icon"><i class="fa-solid fa-hourglass-half"></i></span>
      <div><div class="stat-num"><%= pendingCourseCount %></div><div class="text-secondary small">Awaiting Dean approval</div></div>
    </div></div></div>
    <div class="col"><div class="card stat-card h-100"><div class="card-body d-flex align-items-center gap-3">
      <span class="stat-icon"><i class="fa-solid fa-clipboard-check"></i></span>
      <div><div class="stat-num"><%= pendingCount %></div><div class="text-secondary small">Awaiting your approval</div></div>
    </div></div></div>
    <div class="col"><div class="card stat-card h-100"><div class="card-body d-flex align-items-center gap-3">
      <span class="stat-icon"><i class="fa-regular fa-calendar-check"></i></span>
      <div><div class="stat-num"><%= session ? 'Active' : 'None' %></div><div class="text-secondary small">Session status</div></div>
    </div></div></div>
  </div>
  <div class="d-flex gap-2 flex-wrap mt-4">
    <a class="btn btn-gold" href="/hod/courses"><i class="fa-solid fa-book me-1"></i> Manage courses</a>
    <a class="btn btn-outline-secondary" href="/hod/approvals"><i class="fa-solid fa-clipboard-check me-1"></i> Review approval queue</a>
    <a class="btn btn-outline-secondary" href="/hod/assign"><i class="fa-solid fa-chalkboard-user me-1"></i> Assign lecturers</a>
  </div>
<% } %>
