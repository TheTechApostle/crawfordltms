<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4 pb-3 border-bottom">
  <div><div class="kicker">Head of Department</div><h1 class="h3 mb-0">Approval queue</h1></div>
  <% if (session) { %><span class="badge bg-light text-dark border"><%= session.name %></span><% } %>
</div>

<div class="card"><div class="card-body">
  <p class="text-secondary">These slots have been accepted by the lecturer and are ready for department-level review for internal clashes.</p>
  <% if (!entries.length) { %>
    <p class="text-secondary mb-0">Nothing awaiting your approval right now.</p>
  <% } else { %>
    <div class="table-responsive"><table class="table table-hover align-middle mb-0">
      <thead><tr><th>Course</th><th>Lecturer</th><th>Venue</th><th>Slot</th><th></th></tr></thead>
      <tbody>
      <% entries.forEach(function(e){ %>
        <tr>
          <td><%= e.code %> — <%= e.title %></td>
          <td><%= e.lecturer_name %></td>
          <td><%= e.venue_name %></td>
          <td><%= e.day %> <%= e.start_time %>–<%= e.end_time %></td>
          <td class="d-flex gap-2">
            <form method="POST" action="/hod/approvals/<%= e.id %>/approve"><button class="btn btn-sm btn-gold" type="submit"><i class="fa-solid fa-check me-1"></i> Approve</button></form>
            <form method="POST" action="/hod/approvals/<%= e.id %>/reject">
              <input type="hidden" name="reason" value="Internal department clash">
              <button class="btn btn-sm btn-danger" type="submit"><i class="fa-solid fa-xmark me-1"></i> Reject</button>
            </form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table></div>
  <% } %>
</div></div>
