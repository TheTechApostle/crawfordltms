<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4 pb-3 border-bottom">
  <div><div class="kicker">Student</div><h1 class="h3 mb-0">Dashboard</h1></div>
  <% if (session) { %><span class="badge bg-light text-dark border"><%= session.name %></span><% } %>
</div>

<div class="row g-3 row-cols-1 row-cols-md-3">
  <div class="col"><div class="card stat-card h-100"><div class="card-body d-flex align-items-center gap-3">
    <span class="stat-icon"><i class="fa-solid fa-pen-to-square"></i></span>
    <div><div class="stat-num"><%= registeredCount %></div><div class="text-secondary small">Courses registered</div></div>
  </div></div></div>
  <div class="col"><div class="card stat-card h-100"><div class="card-body d-flex align-items-center gap-3">
    <span class="stat-icon"><i class="fa-regular fa-calendar-check"></i></span>
    <div><div class="stat-num"><%= publishedCount %></div><div class="text-secondary small">Published on timetable</div></div>
  </div></div></div>
  <div class="col"><div class="card stat-card h-100"><div class="card-body d-flex align-items-center gap-3">
    <span class="stat-icon"><i class="fa-solid fa-signal"></i></span>
    <div><div class="stat-num"><%= session ? 'Active' : 'None' %></div><div class="text-secondary small">Session status</div></div>
  </div></div></div>
</div>
<div class="d-flex gap-2 flex-wrap mt-4">
  <a class="btn btn-gold" href="/student/register"><i class="fa-solid fa-pen-to-square me-1"></i> Register courses</a>
  <a class="btn btn-outline-secondary" href="/student/timetable"><i class="fa-regular fa-calendar me-1"></i> My timetable</a>
</div>
