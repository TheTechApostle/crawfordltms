<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4 pb-3 border-bottom">
  <div><div class="kicker">Lecturer</div><h1 class="h3 mb-0">My draft slots</h1></div>
  <% if (session) { %><span class="badge bg-light text-dark border"><%= session.name %></span><% } %>
</div>

<div class="card"><div class="card-body">
  <p class="text-secondary">Accept a draft slot to forward it to your HOD for department approval, or flag it if it clashes with another engagement — the allocation engine will re-run for just that course.</p>
  <% if (!entries.length) { %>
    <p class="text-secondary mb-0">No draft slots awaiting your review.</p>
  <% } else { %>
    <div class="table-responsive"><table class="table table-hover align-middle mb-0">
      <thead><tr><th>Course</th><th>Registered</th><th>Venue</th><th>Slot</th><th></th></tr></thead>
      <tbody>
      <% entries.forEach(function(e){ %>
        <tr>
          <td><%= e.code %> — <%= e.title %></td>
          <td><%= e.registered_count %> / <%= e.capacity %></td>
          <td><%= e.venue_name %></td>
          <td><%= e.day %> <%= e.start_time %>–<%= e.end_time %></td>
          <td class="d-flex gap-2">
            <form method="POST" action="/lecturer/slots/<%= e.id %>/accept"><button class="btn btn-sm btn-gold" type="submit"><i class="fa-solid fa-check me-1"></i> Accept</button></form>
            <form method="POST" action="/lecturer/slots/<%= e.id %>/reject">
              <input type="hidden" name="reason" value="Clash with another engagement">
              <button class="btn btn-sm btn-danger" type="submit"><i class="fa-solid fa-triangle-exclamation me-1"></i> Flag clash</button>
            </form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table></div>
  <% } %>
</div></div>
